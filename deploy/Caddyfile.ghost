:4001 {
    root * /srv
    encode gzip zstd

    # SPA routing fallback for Flutter Web GoRouter
    try_files {path} /index.html

    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

